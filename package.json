{
  "name": "cistory",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "node scripts/check-node-version.mjs && next dev --turbopack",
    "build": "node scripts/check-node-version.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "db:test:migrate": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://cistory_test:cistory_test@localhost:5433/cistory_test}\" node node_modules/tsx/dist/cli.mjs scripts/migrate.ts",
    "test:integration": "yarn db:test:up && yarn db:test:migrate && TEST_DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://cistory_test:cistory_test@localhost:5433/cistory_test}\" vitest run -c vitest.integration.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "spending:backfill-categories": "node scripts/backfill-spending-categories.mjs",
    "location:backfill-heatmaps": "node node_modules/tsx/dist/cli.mjs scripts/backfill-location-heatmaps.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@logtail/node": "^0.6.1",
    "@protontech/crypto": "patch:@protontech/crypto@npm%3A2.2.0#~/.yarn/patches/@protontech-crypto-npm-2.2.0.patch",
    "@protontech/drive-sdk": "0.23.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.11.0",
    "@tanstack/react-query": "^5.107.1",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "better-auth": "^1.7.18",
    "buffer": "^6.0.3",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "core-js": "^3.51.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.0",
    "jpeg-js": "0.4.4",
    "ky": "^1.14.3",
    "lucide-react": "1.70.0",
    "mapbox-gl": "^3.34.2",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "nsfwjs": "4.4.0",
    "pg": "^8.23.1",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "stream-chain": "^4.4.1",
    "stream-json": "^3.8.0",
    "tailwind-merge": "3.7.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/busboy": "^1.5.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "^7",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "resolutions": {
    "@esbuild-kit/core-utils/esbuild": "^0.25.12"
  }
}
