{
  "name": "cistory",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "db:test:migrate": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://cistory_test:cistory_test@localhost:5433/cistory_test}\" npx tsx scripts/migrate.ts",
    "test:integration": "yarn db:test:up && yarn db:test:migrate && TEST_DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://cistory_test:cistory_test@localhost:5433/cistory_test}\" vitest run -c vitest.integration.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "spending:backfill-categories": "node scripts/backfill-spending-categories.mjs",
    "location:backfill-heatmaps": "yarn dlx tsx@4.20.6 scripts/backfill-location-heatmaps.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.117.1",
    "@logtail/node": "^0.5.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.70.0",
    "better-auth": "^1.6.28",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "1.31.0",
    "mapbox-gl": "^3.28.1",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "^19.2.8",
    "react-map-gl": "^8.1.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "stream-chain": "^4.2.5",
    "stream-json": "^3.5.0",
    "tailwind-merge": "^3.0.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/busboy": "^1.5.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.10"
  }
}
