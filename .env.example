# Database (PostgreSQL)
DATABASE_URL=postgresql://cistory:cistory@localhost:5432/cistory

# Better Auth
BETTER_AUTH_SECRET=your_better_auth_secret_generate_with_openssl_rand
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Anthropic API (for commit summaries)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Application URL (for client-side URL resolution)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mapbox (for location map visualization)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token

# Kakao Local API (for Korean location geocoding, optional)
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# Google Maps API (for international geocoding, optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Better Stack (Structured Logging via @logtail/node)
BETTER_STACK_SOURCE_TOKEN=your_better_stack_source_token

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your_token@your_host/1

# KIS (한국투자증권) Portfolio - encryption key for stored app keys/secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KIS_ENCRYPTION_KEY=your_32_or_more_character_secret_string
